# Arch-based build/test image for rusty-bui.
#
# Arch matches the Omarchy base, so Qt6 and qmllint are the versions Omarchy
# ships. Rust comes from the distro package (no rustup inside).
FROM archlinux:latest

RUN pacman -Syu --noconfirm --needed \
      base-devel \
      ca-certificates \
      curl \
      git \
      jq \
      ninja \
      pkgconf \
      python \
      qt6-base \
      qt6-declarative \
      rust \
 && pacman -Scc --noconfirm

# Fonts, for the headless QML render harness (test/render): fontconfig alone ships no
# fonts, so Qt would lay text out against nothing. DejaVu covers ordinary text; the
# Nerd Font packages cover the icon-font glyphs the Omarchy bar uses.
RUN pacman -S --noconfirm --needed \
      ttf-dejavu \
      ttf-jetbrains-mono-nerd \
      ttf-nerd-fonts-symbols \
 && pacman -Scc --noconfirm

# The shell asks for the generic family `monospace` and relies on the desktop having
# aliased it to a Nerd Font (Omarchy does this through fontconfig). Do the same here, so a
# rendered pill shows its icon-font glyph instead of an empty box.
RUN printf '%s\n' \
      '<?xml version="1.0"?>' \
      '<!DOCTYPE fontconfig SYSTEM "fonts.dtd">' \
      '<fontconfig>' \
      '  <match target="pattern">' \
      '    <test qual="any" name="family"><string>monospace</string></test>' \
      '    <edit name="family" mode="assign" binding="strong">' \
      '      <string>JetBrainsMono Nerd Font</string>' \
      '    </edit>' \
      '  </match>' \
      '</fontconfig>' > /etc/fonts/local.conf

ENV CARGO_HOME=/cache/cargo \
    CARGO_TARGET_DIR=/cache/target \
    CARGO_TERM_COLOR=always \
    RUST_BACKTRACE=1

WORKDIR /work
